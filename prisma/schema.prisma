generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  name            String?
  tasks           Task[]
  projects        Project[]
  sharedTasks     SharedTask[]     // Tasks condivisi con questo utente
  comments        Comment[]
  notifications   Notification[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id             String          @id @default(cuid())
  title          String
  description    String?
  completed      Boolean         @default(false)
  priority       Priority        @default(MEDIUM)
  dueDate        DateTime?
  attachmentPath String?
  
  // Nuovi campi per funzionalità smart
  isRecurring    Boolean         @default(false)
  recurrenceRule RecurrenceRule? // Relazione one-to-one opzionale
  
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id])
  
  tags           Tag[]
  sharedWith     SharedTask[]
  comments       Comment[]
  subtasks       Task[]          @relation("Subtasks") // Self-relation: questo task ha subtask
  parentTask     Task?           @relation("Subtasks", fields: [parentTaskId], references: [id])
  parentTaskId   String?
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// Modello per regole di ricorrenza
model RecurrenceRule {
  id           String              @id @default(cuid())
  taskId       String              @unique
  task         Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  frequency    RecurrenceFrequency
  interval     Int                 @default(1)  // Ogni X giorni/settimane/mesi
  endDate      DateTime?           // Quando smette di ripetersi (null = infinito)
  lastRun      DateTime?           // Ultima volta che è stato generato un task ricorrente
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

// Tabella pivot per condivisione task
model SharedTask {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("VIEWER") // VIEWER o EDITOR
  createdAt DateTime @default(now())
  
  @@unique([taskId, userId]) // Un utente può essere aggiunto una sola volta per task
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  taskId    String?          // Opzionale: link al task correlato
  createdAt DateTime         @default(now())
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationType {
  TASK_SHARED
  COMMENT_ADDED
  TASK_UPDATED
  DUE_DATE_REMINDER
}
